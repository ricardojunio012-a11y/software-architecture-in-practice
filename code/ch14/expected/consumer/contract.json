{
  "consumer": "monolith",
  "provider": "communications",
  "interactions": [
    {
      "description": "sending a new notice",
      "state": "no notice has been sent",
      "request": {
        "method": "POST",
        "path": "/notices",
        "body": {
          "id": "E-P-001",
          "text": "payment received"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "notice": "E-P-001",
          "status": "sent"
        }
      }
    },
    {
      "description": "resending a notice already sent",
      "state": "notice E-P-001 has already been sent",
      "request": {
        "method": "POST",
        "path": "/notices",
        "body": {
          "id": "E-P-001",
          "text": "payment received"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "notice": "E-P-001",
          "status": "duplicate"
        }
      }
    },
    {
      "description": "notice without text",
      "state": "no notice has been sent",
      "request": {
        "method": "POST",
        "path": "/notices",
        "body": {
          "id": "E-P-002",
          "text": ""
        }
      },
      "response": {
        "status": 400,
        "body": {
          "error": "text is required"
        }
      }
    }
  ]
}
